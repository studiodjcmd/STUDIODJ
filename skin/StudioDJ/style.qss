/* Studio DJ 0.0.3 — native Qt widgets, no custom paint in audio path. */
QWidget { color:#F5F5F7; font-family:"Segoe UI","Noto Sans",sans-serif; font-size:13px; background:#101012; }
#Mixxx { background:#101012; qproperty-layoutSpacing:10; padding:12px; }
WWidgetGroup { border:0; qproperty-layoutSpacing:8; background:transparent; }
WLabel, WLabel QLabel, WNumber, WNumber QLabel, WNumberRate, WNumberRate QLabel,
WNumberPos, WNumberPos QLabel, WKey, WKey QLabel, WTrackProperty, WTrackProperty QLabel {
 background:transparent; border:0; color:#F5F5F7;
}
#Toolbar { background:#1A1A1E; padding:12px; qproperty-layoutSpacing:12; qproperty-layoutAlignment:'AlignLeft | AlignVCenter'; border:1px solid #2C2C31; border-radius:10px; }
#Brand, #Brand QLabel { font-size:25px; font-weight:600; color:#F5F5F7; }
#DeckStrip { qproperty-layoutSpacing:12; }
#DeckCard { background:#1C1C20; border:1px solid #34343B; border-radius:12px; padding:12px; qproperty-layoutSpacing:7; qproperty-layoutAlignment:'AlignTop'; }
#DeckHead, #DeckFoot { qproperty-layoutSpacing:10; qproperty-layoutAlignment:'AlignLeft | AlignVCenter'; }
#TrackTitle, #TrackTitle QLabel { font-size:20px; font-weight:600; color:#F5F5F7; min-height:26px; }
#Artist, #Artist QLabel { font-size:13px; color:#A0A0A8; min-height:18px; }
#Caption, #Caption QLabel { font-size:10px; font-weight:500; color:#A1A1AA; }
#Bpm, #Bpm QLabel { font-size:28px; font-weight:600; color:#FFFFFF; }
#Metric, #Metric QLabel { font-size:18px; font-weight:500; }
#MetricBlock { qproperty-layoutSpacing:2; qproperty-layoutAlignment:'AlignLeft | AlignVCenter'; }
#DeckLabel1, #DeckLabel1 QLabel { color:#0A84FF; font-weight:600; }
#DeckLabel2, #DeckLabel2 QLabel { color:#FF9F0A; font-weight:600; }
#DeckLabel3, #DeckLabel3 QLabel { color:#BF5AF2; font-weight:600; }
#DeckLabel4, #DeckLabel4 QLabel { color:#64D2FF; font-weight:600; }
#Layer, #Layer QLabel { color:#FFFFFF; font-size:10px; font-weight:600; }
#Status, #Status QLabel { color:#82828C; font-size:10px; }
#Status[highlight="1"], #Status[highlight="1"] QLabel { color:#30D158; font-weight:600; }
#ModeButton,#Button { background:#29292E; color:#E8E8ED; border:1px solid #3B3B44; border-radius:7px; }
#ModeButton[displayValue="1"] { background:#254E7C; border-color:#0A84FF; }
#Waveforms { background:#0D0E11; border:1px solid #2E2E34; border-radius:10px; padding:12px; qproperty-layoutSpacing:8; }
#WaveLane { background:#101116; border-bottom:1px solid #2C2E36; qproperty-layoutSpacing:10; }
#WaveLane WLabel, #WaveLane WLabel QLabel { font-size:17px; min-width:32px; }
#BrowseWorkspace { background:#17171A; border:1px solid #2E2E34; border-radius:10px; padding:12px; qproperty-layoutSpacing:8; }
#LibraryHeader { qproperty-layoutAlignment:'AlignLeft | AlignVCenter'; qproperty-layoutSpacing:10; }
#SectionTitle, #SectionTitle QLabel { font-size:18px; font-weight:600; }
QLineEdit { background:#26262B; border:1px solid #42424A; border-radius:7px; padding:8px; color:#F5F5F7; }
QTableView,QTreeView { background:#19191D; alternate-background-color:#202024; selection-background-color:#244B79; gridline-color:#27272D; border:0; }
QTableView::item,QTreeView::item { padding:4px; border:0; }
QHeaderView::section { background:#222227; color:#A7A7AF; padding:8px; border:0; }
QScrollBar:vertical { background:#17171A; width:10px; margin:0; }
QScrollBar:horizontal { background:#17171A; height:10px; margin:0; }
QScrollBar::handle { background:#47474E; border-radius:4px; min-width:20px; min-height:20px; }
QScrollBar::add-line,QScrollBar::sub-line { width:0; height:0; }
QSplitter::handle { background:#25252A; width:6px; }
